<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="620.0" prefWidth="880.0" stylesheets="@Styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.club_sporting_final.admin.Controller.ReportsController">

   <VBox alignment="TOP_LEFT" spacing="18" style="-fx-padding: 28;"
         AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
         AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

      <!-- ─── Header Row ─── -->
      <HBox alignment="CENTER_LEFT" spacing="15">
         <Label text="📊  Financial Reports" styleClass="header-label"/>
         <Region HBox.hgrow="ALWAYS"/>
         <Label text="Filter by:" styleClass="category"/>
         <ChoiceBox fx:id="filterChoiceBox" prefWidth="150"/>
         <Button onAction="#handleApplyFilter" prefHeight="38" prefWidth="110" text="Apply Filter"/>
         <Button fx:id="generateReportButton" onAction="#handleGenerateReport" styleClass="success-button" prefHeight="38" prefWidth="120" text="Export CSV"/>
      </HBox>


      <!-- ─── Table ─── -->
      <TableView fx:id="reportsTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="columnName" text="Name / Expense Type" prefWidth="250"/>
            <TableColumn fx:id="columnCategory" text="Category" prefWidth="130"/>
            <TableColumn fx:id="columnAmount" text="Amount ($)" prefWidth="120"/>
            <TableColumn fx:id="columnDate" text="Date" prefWidth="130"/>
            <TableColumn fx:id="columnDetails" text="Details" prefWidth="180"/>
         </columns>
      </TableView>


      <!-- ─── Summary Cards & Actions ─── -->
      <HBox alignment="CENTER_LEFT" spacing="15">
         <VBox alignment="CENTER" spacing="5" prefWidth="160" prefHeight="70" styleClass="card">
            <Label text="TOTAL INCOME" styleClass="category" style="-fx-font-size: 11px;"/>
            <Label fx:id="totalIncomeLabel" style="-fx-text-fill: #87CB16; -fx-font-size: 22px; -fx-font-weight: bold;" text="\$0.00"/>
         </VBox>

         <VBox alignment="CENTER" spacing="5" prefWidth="160" prefHeight="70" styleClass="card">
            <Label text="TOTAL EXPENSE" styleClass="category" style="-fx-font-size: 11px;"/>
            <Label fx:id="totalExpensesLabel" style="-fx-text-fill: #FF4A55; -fx-font-size: 22px; -fx-font-weight: bold;" text="\$0.00"/>
         </VBox>

         <VBox alignment="CENTER" spacing="5" prefWidth="160" prefHeight="70" styleClass="card">
            <Label text="NET BALANCE" styleClass="category" style="-fx-font-size: 11px;"/>
            <Label fx:id="netBalanceLabel" style="-fx-text-fill: #1DC7EA; -fx-font-size: 22px; -fx-font-weight: bold;" text="\$0.00"/>
         </VBox>

         <Region HBox.hgrow="ALWAYS"/>
         <Button onAction="#goBackToDashboard" text="← Back to Dashboard" prefHeight="38" prefWidth="170"/>
      </HBox>

   </VBox>
</AnchorPane>
