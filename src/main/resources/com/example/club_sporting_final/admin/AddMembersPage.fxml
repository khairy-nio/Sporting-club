<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="480.0" stylesheets="@Styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.club_sporting_final.admin.Controller.AddMemberController">

   <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30;"
         AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
         AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

      <Label text="➕  Add New Member" styleClass="header-label"/>

      <VBox spacing="15" styleClass="form-card">
         <VBox spacing="5">
            <Label text="Full Name" styleClass="category"/>
            <TextField fx:id="nameField" promptText="Enter full name"/>
         </VBox>

         <VBox spacing="5">
            <Label text="Email Address" styleClass="category"/>
            <TextField fx:id="emailField" promptText="example@email.com"/>
         </VBox>

         <VBox spacing="5">
            <Label text="Phone Number" styleClass="category"/>
            <TextField fx:id="phoneField" promptText="11 digits"/>
         </VBox>

         <VBox spacing="5">
            <Label text="Assign Team" styleClass="category"/>
            <ChoiceBox fx:id="teamChoiceBox" prefWidth="400"/>
         </VBox>

         <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
            <CheckBox fx:id="subscriptionStatus" text="Activate Subscription Plan" style="-fx-font-weight: bold;"/>
            <HBox spacing="15" style="-fx-padding: 0 0 0 25;">
               <RadioButton fx:id="monthlyPlan" text="Monthly ($50)"/>
               <RadioButton fx:id="quarterlyPlan" text="Quarterly ($150)"/>
               <RadioButton fx:id="yearlyPlan" text="Yearly ($500)"/>
            </HBox>
         </VBox>
      </VBox>

      <HBox alignment="CENTER" spacing="15">
         <Button fx:id="cancelButton" onAction="#handleCancel" text="Cancel" prefHeight="38" prefWidth="120"/>
         <Button fx:id="saveButton" onAction="#handleSave" text="Save Member" styleClass="primary-button" prefHeight="38" prefWidth="160"/>
      </HBox>

   </VBox>
</AnchorPane>
