<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="700.0" stylesheets="@Styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.club_sporting_final.admin.Controller.MemberProfileController">

   <VBox alignment="TOP_LEFT" spacing="18" style="-fx-padding: 25;"
         AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
         AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

      <Label text="👤  Member Profile" styleClass="header-label"/>

      <!-- ─── Profile Card ─── -->
      <VBox spacing="12" styleClass="form-card">
         <HBox spacing="40">
            <VBox spacing="8">
               <Label text="MEMBER ID" styleClass="category" style="-fx-font-size: 11px;"/>
               <Label fx:id="profileIdLabel" style="-fx-text-fill: #333333; -fx-font-size: 18px; -fx-font-weight: bold;" text="—"/>
            </VBox>
            <VBox spacing="8">
               <Label text="FULL NAME" styleClass="category" style="-fx-font-size: 11px;"/>
               <Label fx:id="profileNameLabel" style="-fx-text-fill: #333333; -fx-font-size: 18px; -fx-font-weight: bold;" text="—"/>
            </VBox>
            <VBox spacing="8">
               <Label text="STATUS" styleClass="category" style="-fx-font-size: 11px;"/>
               <Label fx:id="profileStatusLabel" style="-fx-text-fill: #87CB16; -fx-font-size: 18px; -fx-font-weight: bold;" text="—"/>
            </VBox>
         </HBox>
         <HBox spacing="40">
            <VBox spacing="8">
               <Label text="EMAIL" styleClass="category" style="-fx-font-size: 11px;"/>
               <Label fx:id="profileEmailLabel" style="-fx-text-fill: #565656; -fx-font-size: 14px;" text="—"/>
            </VBox>
            <VBox spacing="8">
               <Label text="PHONE" styleClass="category" style="-fx-font-size: 11px;"/>
               <Label fx:id="profilePhoneLabel" style="-fx-text-fill: #565656; -fx-font-size: 14px;" text="—"/>
            </VBox>
            <VBox spacing="8">
               <Label text="TEAM" styleClass="category" style="-fx-font-size: 11px;"/>
               <Label fx:id="profileTeamLabel" style="-fx-text-fill: #565656; -fx-font-size: 14px;" text="—"/>
            </VBox>
         </HBox>
      </VBox>

      <!-- ─── Subscription History Table ─── -->
      <Label text="Subscription History" styleClass="category" style="-fx-font-weight: bold;"/>
      <TableView fx:id="subscriptionHistoryTable" prefHeight="160.0" VBox.vgrow="NEVER">
         <columns>
            <TableColumn fx:id="subPlanCol" text="Plan" prefWidth="160"/>
            <TableColumn fx:id="subStartCol" text="Start Date" prefWidth="130"/>
            <TableColumn fx:id="subEndCol" text="End Date" prefWidth="130"/>
            <TableColumn fx:id="subAmountCol" text="Amount" prefWidth="100"/>
         </columns>
      </TableView>

      <!-- ─── Attendance Summary Table ─── -->
      <Label text="Recent Attendance (Last 20 Sessions)" styleClass="category" style="-fx-font-weight: bold;"/>
      <TableView fx:id="attendanceSummaryTable" prefHeight="160.0" VBox.vgrow="NEVER">
         <columns>
            <TableColumn fx:id="attDateCol" text="Date" prefWidth="130"/>
            <TableColumn fx:id="attSessionCol" text="Session" prefWidth="180"/>
            <TableColumn fx:id="attStatusCol" text="Status" prefWidth="120"/>
         </columns>
      </TableView>

      <!-- ─── Close Button ─── -->
      <HBox alignment="CENTER_RIGHT">
         <Button text="✕  Close" onAction="#handleClose" prefHeight="36" prefWidth="110"/>
      </HBox>

   </VBox>
</AnchorPane>
